{
  "name": "healthage-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "nuke": "kill -9 $(lsof -t -i:8081) || true",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d --build",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f app",
    "docker:migrate": "docker compose run --rm app pnpm db:migrate",
    "docker:db:shell": "docker compose exec postgres psql -U healthage -d healthage",
    "docker:db:dump": "docker compose exec postgres pg_dump -U healthage -d healthage > backup.sql",
    "docker:studio": "docker compose --profile tools up -d studio",
    "docker:studio:logs": "docker compose --profile tools logs -f studio",
    "docker:studio:down": "docker compose --profile tools stop studio",
    "docker:studio:public": "docker compose --profile tools up -d --force-recreate studio",
    "docker:studio:url": "echo https://local.drizzle.studio/?host=http://<EC2_PUBLIC_IP>:4983",
    "ec2:nginx": "./scripts/configure-nginx-ec2.sh ha.wisdomtooth.tech",
    "ec2:nginx:ssl": "ENABLE_SSL=true ./scripts/configure-nginx-ec2.sh ha.wisdomtooth.tech"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@tsconfig/node22": "^22.0.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
